.version 8.8
.target sm_120a
.address_size 64

.shared .align 128 .b8 smem_dst[128];
.shared .align 8 .b8 mbar[8];
.visible .entry tma_probe()
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<4>;
    mov.u32 %r1, smem_dst;
    mov.u32 %r2, mbar;
    cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes
        [%r1], [%rd3, {%r3, %r4}], [%r2];
    ret;
}
