.version 8.8
.target sm_120
.address_size 64

.shared .align 4 .b8 tmem_addr[4];
.visible .entry tcgen05_alloc_probe()
{
    .reg .b32 %r<4>;
    mov.u32 %r1, tmem_addr;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r1], 64;
    tcgen05.relinquish_alloc_permit.cta_group::1.sync.aligned;
    ret;
}
