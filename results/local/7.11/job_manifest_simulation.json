{
  "manifest": {
    "job_id": "job-smollm3-3b-pretrain-001",
    "job_name": "smollm3-3b-stage1",
    "model_name": "SmolLM3-3B",
    "resources": {
      "num_nodes": 8,
      "gpus_per_node": 8,
      "cpus_per_task": 12,
      "memory_per_node_gb": 512,
      "gpu_type": "H100-SXM5-80GB",
      "interconnect": "InfiniBand-400Gbps"
    },
    "rendezvous": {
      "backend": "c10d",
      "master_addr": "master-0.cluster.local",
      "master_port": 29500,
      "timeout_seconds": 1800
    },
    "restart_policy": {
      "max_restarts": 3,
      "restart_delay_seconds": 10,
      "auto_resume": true,
      "checkpoint_dir": "/Volumes/data/checkpoints/smollm3-3b"
    },
    "environment_variables": {
      "NCCL_DEBUG": "INFO",
      "TORCH_NCCL_ASYNC_ERROR_HANDLING": "1",
      "CUDA_DEVICE_MAX_CONNECTIONS": "1"
    },
    "command": [
      "torchrun",
      "--nproc_per_node=8",
      "--nnodes=8",
      "train.py",
      "--config=recipes/smollm3.yaml"
    ]
  },
  "state_machine_history": [
    {
      "from_state": "PENDING",
      "to_state": "ADMITTED",
      "restart_count": 0,
      "reason": "Gang admission granted; all requested nodes and GPUs available"
    },
    {
      "from_state": "ADMITTED",
      "to_state": "INITIALIZING",
      "restart_count": 0,
      "reason": "Rendezvous joined by 64 ranks via c10d:29500"
    },
    {
      "from_state": "INITIALIZING",
      "to_state": "RUNNING",
      "restart_count": 0,
      "reason": "Distributed communication established; training loop started at step 0"
    },
    {
      "from_state": "RUNNING",
      "to_state": "FAILED_TRANSIENT",
      "restart_count": 0,
      "reason": "Node worker-node-1 encountered NCCL watchdog timeout at step 1500"
    },
    {
      "from_state": "FAILED_TRANSIENT",
      "to_state": "RESTARTING",
      "restart_count": 1,
      "reason": "Restart policy invoked (attempt 1/3)"
    },
    {
      "from_state": "RESTARTING",
      "to_state": "RESUMING",
      "restart_count": 1,
      "reason": "Loading latest valid checkpoint from /Volumes/data/checkpoints/smollm3-3b at step 1450"
    },
    {
      "from_state": "RESUMING",
      "to_state": "RUNNING",
      "restart_count": 1,
      "reason": "Resumed execution from checkpoint; trained to final step 3000"
    },
    {
      "from_state": "RUNNING",
      "to_state": "COMPLETED",
      "restart_count": 1,
      "reason": "Target token budget reached successfully; final checkpoint committed"
    }
  ]
}