{
  "model": "SmolLM3-3B",
  "stages": [
    {
      "stage": "Stage 1",
      "tokens": "3.0T",
      "seq_len": 4096,
      "learning_rate": "3e-4 -> 3e-5 (WSD)",
      "data_blend": "FineWeb-Edu 50%, DCLM 30%, Github 10%, SmolLM-Corpus 10%",
      "framework": "Nanotron",
      "sharding": "FSDP / ZeRO-3"
    },
    {
      "stage": "Stage 2 (Mid-training)",
      "tokens": "1.0T",
      "seq_len": 4096,
      "learning_rate": "1e-4 -> 1e-5 (Cosine)",
      "data_blend": "Math, Code, Reasoning-heavy tokens, Synthetic CoT",
      "framework": "Nanotron",
      "sharding": "FSDP / ZeRO-3"
    },
    {
      "stage": "Stage 3 (Context Extension)",
      "tokens": "50B",
      "seq_len": 8192,
      "learning_rate": "5e-5 (Constant decay)",
      "data_blend": "Long-context books, code repos, multi-document QA",
      "framework": "Nanotron",
      "sharding": "FSDP + Context Parallelism"
    },
    {
      "stage": "Post-training 1 (SFT)",
      "tokens": "5B",
      "seq_len": 4096,
      "framework": "Alignment Handbook (TRL SFTTrainer)",
      "optimizer": "AdamW, lr=2e-5",
      "masking": "Prompt unmasked loss=0, Assistant response loss=1"
    },
    {
      "stage": "Post-training 2 (APO / DPO)",
      "tokens": "1B (Pairs)",
      "seq_len": 4096,
      "framework": "Alignment Handbook (TRL DPOTrainer)",
      "loss": "Anchored Preference Optimization (APO)",
      "reference_model": "Frozen SFT Model"
    }
  ],
  "four_framework_mapping": {
    "torch_titan": {
      "entrypoint": "torchtitan/train.py",
      "parallel_api": "torch.distributed.fsdp.fully_shard (FSDP2)",
      "checkpoint": "components/checkpointer/dcp.py",
      "models": "torchtitan/models/llama3/ / config_registry.py"
    },
    "nanotron": {
      "entrypoint": "run_train.py",
      "parallel_api": "nanotron.parallel.pipeline_parallel / tensor_parallel",
      "checkpoint": "nanotron.serialize.save_checkpoint",
      "models": "nanotron.models.llama / nanotron.config"
    },
    "deepspeed": {
      "entrypoint": "deepspeed.initialize",
      "parallel_api": "DeepSpeedEngine / ZeRO-Stage 1/2/3",
      "checkpoint": "engine.save_checkpoint / load_checkpoint",
      "models": "Any torch.nn.Module wrapped by DeepSpeed"
    },
    "megatron_core": {
      "entrypoint": "megatron/core/pipeline_parallel / tensor_parallel",
      "parallel_api": "mcore.tensor_parallel / mcore.distributed",
      "checkpoint": "megatron.core.dist_checkpointing",
      "models": "megatron.core.models.gpt.GPTModel"
    }
  }
}